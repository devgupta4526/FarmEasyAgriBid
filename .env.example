# =============================================
# AGRIBID – Environment Variables Template
# =============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ----------------------------
# SUPABASE
# ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ----------------------------
# BACKEND
# ----------------------------
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/agribid
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ----------------------------
# FRONTEND
# ----------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgriBid

# ----------------------------
# GOOGLE GEMINI AI
# ----------------------------
GEMINI_API_KEY=your-google-gemini-api-key

# ----------------------------
# RESEND EMAIL
# ----------------------------
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@agribid.com

# ----------------------------
# FIREBASE CLOUD MESSAGING
# ----------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ----------------------------
# POSTHOG ANALYTICS
# ----------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----------------------------
# SENTRY ERROR MONITORING
# ----------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ----------------------------
# REDIS (Optional - Upstash Free)
# ----------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ----------------------------
# STORAGE
# ----------------------------
SUPABASE_STORAGE_BUCKET_IMAGES=product-images
SUPABASE_STORAGE_BUCKET_DOCS=documents
SUPABASE_STORAGE_BUCKET_VIDEOS=videos
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# ----------------------------
# APP CONFIG
# ----------------------------
AUCTION_ANTI_SNIPE_MINUTES=2
AUCTION_ANTI_SNIPE_THRESHOLD_MINUTES=1
DEFAULT_BID_INCREMENT=10
PLATFORM_FEE_PERCENT=2.5
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif
